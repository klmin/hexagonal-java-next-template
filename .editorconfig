root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{java,kts,gradle}]
indent_size = 4

[*.kts]
# build.gradle.kts 의 ktlint (backend 의 spotless). IntelliJ 의 Reformat Code 와 충돌하지 않게 intellij_idea 스타일
ktlint_code_style = intellij_idea

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf
